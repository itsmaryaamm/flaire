# ---- Flaire backend ----
ENV=dev
# SQLite for local dev. On Render/Neon/Supabase paste the postgres URL, e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./flaire.db

# Change these in production
JWT_SECRET=change-me-in-production-please
RECEIPT_SECRET=flaire-dev-receipt-secret

# Comma separated. Add your Vercel URL after deploying the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authorization engine: native (default) or shotoku (needs the sidecar running, see backend/app/integrations/shotoku/service)
AUTH_ENGINE=native
SHOTOKU_SERVICE_URL=http://localhost:8788

# Real Claude AI employees. Leave empty to use the scripted fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Lithic sandbox (optional). Sandbox key from https://dashboard.lithic.com
LITHIC_API_KEY=
LITHIC_BASE_URL=https://sandbox.lithic.com/v1
