# ---- Flaire backend ----
ENV=dev
# SQLite for local dev. On Render/Neon/Supabase paste the postgres URL, e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./flaire.db

# Change these in production
JWT_SECRET=change-me-in-production-please
RECEIPT_SECRET=flaire-dev-receipt-secret
APP_ENCRYPTION_KEY=            # encrypts per-company payment keys; defaults to JWT_SECRET
# Public URL of this API (used in OAuth metadata). Render: https://flaire-api-xxxx.onrender.com
API_BASE_URL=http://localhost:8000

# Comma separated. Add your Vercel URL after deploying the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authorization engine: native (default) or shotoku (needs the sidecar running, see backend/app/integrations/shotoku/service)
AUTH_ENGINE=native
SHOTOKU_SERVICE_URL=http://localhost:8788

# Real Claude AI employees. Leave empty to use the scripted fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Lithic sandbox (optional). Sandbox key from https://dashboard.lithic.com
LITHIC_API_KEY=
LITHIC_BASE_URL=https://sandbox.lithic.com/v1
# Flaire amounts are SAR; Lithic sandbox cards are USD. Halalas are converted to cents at this rate before the issuer is called.
FX_SAR_USD=3.75
# Webhook signing secret (whsec_...) if you register https://<api>/api/v1/webhooks/lithic in the Lithic dashboard
LITHIC_WEBHOOK_SECRET=

# Approval emails (optional). Gmail works with an app password: SMTP_HOST=smtp.gmail.com SMTP_USER=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where the approve link in emails points (your Vercel URL in production)
DASHBOARD_URL=http://localhost:5173

# Platform owner console (GET /platform/*). Comma separated emails of the people who run Flaire itself.
PLATFORM_ADMIN_EMAILS=you@yourcompany.com,cofounder@yourcompany.com
# Mandatory 2FA for every member of companies created from now on (existing companies are switched on by the migration).
REQUIRE_2FA_FOR_NEW_COMPANIES=1

# ---- Supabase Auth (optional). When set, sign-up/login/reset move to Supabase; Flaire keeps roles, companies and 2FA.
# Project Settings → API. Add https://<your-dashboard>/** to Authentication → URL Configuration → Redirect URLs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
